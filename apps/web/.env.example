# External Fastify origin without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000
# devnet or localnet. Must match the API.
NEXT_PUBLIC_NETWORK=devnet
# Optional devnet URL containing a dedicated browser-safe key. Leave empty for localnet.
NEXT_PUBLIC_HELIUS_RPC_URL=
# Explicitly enable test deposits only on an isolated devnet or localnet preview.
NEXT_PUBLIC_ENABLE_TEST_DEPOSITS=false
# Comma-separated ISO alpha-2 codes. Effective behind Vercel's managed edge.
BLOCKED_COUNTRIES=
# Enable opt-in browser-proved sends and withdrawals with disposable test assets.
NEXT_PUBLIC_ENABLE_TEST_SPENDS=false

{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"isolatedModules": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"allowJs": true,
		"incremental": true,
		"resolveJsonModule": true
	},
	"include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}

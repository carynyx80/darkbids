# Local PostgreSQL from compose.yaml. Use Railway's Postgres URL for a hosted devnet preview.
DATABASE_URL=postgresql://veil:veil@127.0.0.1:5432/veil
# Replace with a unique randomly generated secret of at least 32 characters.
JWT_SECRET=
# Exact allowed web origin and wallet sign-in domain. No trailing path.
WEB_ORIGIN=http://localhost:3000
# Additional first-party origin for a domain transition.
# ADDITIONAL_WEB_ORIGIN=
PORT=4000
# Loopback for local development. The container sets 0.0.0.0.
HOST=127.0.0.1
# Use mainnet only with explicit enablement.
NEXT_PUBLIC_NETWORK=devnet
ENABLE_MAINNET=false
# Development launcher overrides for infrastructure already running separately.
VEIL_EXTERNAL_POSTGRES=false
VEIL_EXTERNAL_ZOLANA=false

# Optional public Solana treasury address. Holds no signing authority.
TREASURY_WALLET_ADDRESS=
# Explicit network for the treasury designation, independent of the preview network.
TREASURY_WALLET_NETWORK=devnet
# Optional server-only Helius credential for authenticated mainnet vault reads.
# Set this in the Railway service environment and omit it entirely when unused.
# HELIUS_MAINNET_API_KEY=
ENABLE_MAINNET_VAULT_READS=false

# Mainnet vault transaction switch. Keep disabled until the round trip is verified.
ENABLE_MAINNET_VAULT_WRITES=false

# Enables mainnet OTC funding and settlement in pilot or public mode.
ENABLE_MAINNET_OTC_SETTLEMENT=false
ENABLE_CAPPED_PUBLIC_OTC_BETA=false
# Comma-separated public addresses in seller,buyer order.
# OTC_PILOT_WALLETS=
# Dedicated settlement authority, 32-byte Ed25519 seed in base64. Store as a secret.
# OTC_SETTLEMENT_SIGNER_SEED=

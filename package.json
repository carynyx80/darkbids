{
	"name": "veil",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"lint": "biome lint .",
		"build": "pnpm -r build",
		"test:api": "node scripts/api-smoke.mjs",
		"test:localnet": "VEIL_LOCALNET_TEST=true NEXT_PUBLIC_NETWORK=localnet NEXT_PUBLIC_ENABLE_TEST_DEPOSITS=true vitest run apps/web/app/localnet.test.ts"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vitest": "^4.0.0",
		"@biomejs/biome": "^2.4.0",
		"@types/node": "^24.0.0"
	}
}
